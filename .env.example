# =====================================================================================
# Configuration de l'application CGRS - Réceptions & stocks
# =====================================================================================
# Copiez ce fichier en .env et modifiez les valeurs selon votre environnement

# -----------------------------------------------------------------------------
# Environnement
# -----------------------------------------------------------------------------
ENVIRONMENT=development  # development | staging | production
DEBUG=true

# -----------------------------------------------------------------------------
# Serveur
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=4

# -----------------------------------------------------------------------------
# Base de données SQLite
# -----------------------------------------------------------------------------
# Chemin vers la base de données (relatif au répertoire de données)
DATABASE_PATH=cantine.db

# -----------------------------------------------------------------------------
# Répertoires
# -----------------------------------------------------------------------------
# Répertoire des uploads (PDF, images, etc.)
UPLOADS_DIR=uploads
# Répertoire des sauvegardes automatiques
BACKUPS_DIR=sauvegardes-auto
# Répertoire des fichiers statiques (frontend)
STATIC_DIR=static

# -----------------------------------------------------------------------------
# Authentification
# -----------------------------------------------------------------------------
# Secret pour la génération des tokens de session (32 caractères aléatoires)
SECRET_KEY=changer-ceci-en-une-cle-secrete-aleatoire-de-32-caracteres-minimum
# Algorithme de hachage des mots de passe
PASSWORD_HASH_ALGORITHM=pbkdf2_sha256
# Nombre d'itérations pour PBKDF2
PBKDF2_ITERATIONS=240000
# Durée de validité des sessions (en jours)
SESSION_EXPIRY_DAYS=30
# Nom du cookie de session
SESSION_COOKIE_NAME=cgrs_session

# -----------------------------------------------------------------------------
# Sécurité
# -----------------------------------------------------------------------------
# Activer la protection CSRF
CSRF_PROTECTION=true
# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Activer le mode HTTPS (pour les cookies Secure)
HTTPS_MODE=false

# -----------------------------------------------------------------------------
# OCR (Reconnaissance optique de caractères)
# -----------------------------------------------------------------------------
# Chemin vers l'exécutable tesseract (laisser vide pour désactiver)
TESSERACT_PATH=
# Langues pour Tesseract (séparées par des +)
TESSERACT_LANGUAGES=fra+eng

# -----------------------------------------------------------------------------
# Journalisation (Logs)
# -----------------------------------------------------------------------------
# Niveau de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
# Fichier de log (laisser vide pour la sortie standard)
LOG_FILE=
# Taille maximale des fichiers de log (en Mo)
LOG_MAX_SIZE=10
# Nombre de fichiers de log à conserver
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# Sauvegardes automatiques
# -----------------------------------------------------------------------------
# Activer les sauvegardes automatiques
AUTO_BACKUP_ENABLED=true
# Fréquence des sauvegardes (en heures)
AUTO_BACKUP_FREQUENCY=24
# Nombre de sauvegardes à conserver
AUTO_BACKUP_RETENTION=7

# -----------------------------------------------------------------------------
# Export Dolibarr
# -----------------------------------------------------------------------------
# Noms des clients pour l'export Dolibarr (séparés par des points-virgules)
CLIENT_NAMES=

# -----------------------------------------------------------------------------
# Limites
# -----------------------------------------------------------------------------
# Taille maximale des fichiers uploadés (en Mo)
MAX_UPLOAD_SIZE=25
# Nombre maximal de tentatives de connexion
MAX_LOGIN_ATTEMPTS=5
# Durée de blocage après trop de tentatives (en secondes)
LOGIN_LOCKOUT_DURATION=60
